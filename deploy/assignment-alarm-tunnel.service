[Unit]
Description=Assignment Alarm fixed Cloudflare VPC tunnel
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/seongmin/assignment-alarm
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --protocol quic run --token-file /home/ubuntu/seongmin/assignment-alarm/.runtime/tunnel-token
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/seongmin/assignment-alarm/.runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
