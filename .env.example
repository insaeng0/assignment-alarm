MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=assignment_alarm
MYSQL_USER=assignment_user
MYSQL_PASSWORD=change-this-db-password
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
TRUST_PROXY=false
AUTH_RATE_MAX_TRACKED_CLIENTS=5000
ASSIGNMENT_IMAGE_RATE_LIMIT=10
ASSIGNMENT_IMAGE_RATE_WINDOW_MS=600000
ASSIGNMENT_WRITE_RATE_LIMIT=20
ASSIGNMENT_WRITE_RATE_WINDOW_MS=600000
GOOGLE_CLIENT_ID=
# AI 챗봇 코드는 주석으로 보존되어 있으며 키를 넣어도 활성화되지 않습니다.
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_GOOGLE_EMAILS=
# 명시적으로 켜면 teacher + 숫자 + @bssm.hs.kr의 정확한 형식만 관리자 허용.
ALLOW_TEACHER_NUMBER_ADMINS=false
ADMIN_EXCLUDED_GOOGLE_EMAILS=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_GRADE=1
ADMIN_CLASS=1

# 운영 환경에서 실제 HTTPS 주소를 설정하세요.
APP_ORIGIN=http://localhost:3000
# GitHub Pages 등 별도 프런트를 사용할 때 브라우저의 정확한 Origin을 지정합니다.
# 저장소 경로(/repo)는 넣지 않습니다. 비워 두면 APP_ORIGIN을 사용합니다.
FRONTEND_ORIGIN=
# 도메인 없이 github.io 프런트를 쓸 때 bearer를 사용합니다.
# production + 명시한 HTTPS FRONTEND_ORIGIN이 필요합니다.
# 단기 접근 토큰은 탭에, 교체되는 갱신 자격은 브라우저 IndexedDB에 저장합니다.
# 갱신 세션은 DB에 해시로 저장되어 서버 재시작 후에도 이어집니다.
PAGES_AUTH_MODE=cookie
# 맥북 중계 복구: Cloudflare 우선, 반복 실패 시 SSH 중계로 전환합니다.
TUNNEL_PROVIDER=auto
# 고정 공개 네임스페이스(임의 32바이트 hex). 터널 주소 변경 시에도 유지하세요.
# Pages의 ASSIGNMENT_AUTH_REALM 저장소 변수에도 같은 값을 설정합니다.
AUTH_REALM_ID=
# 메모리 세션 전체 한도(5~5000). 사용자당 최근 5개 탭/로그인만 유지합니다.
PAGES_ACCESS_MAX_SESSIONS=5000
# app.example.com / api.example.com처럼 같은 Site이면 lax를 유지하세요.
# github.io와 다른 API 도메인을 직접 연결할 때만 none을 명시합니다.
# none은 production + 명시한 HTTPS 프런트에서만 허용되며 Secure 쿠키를 씁니다.
# 브라우저의 서드파티 쿠키 차단은 none으로도 우회할 수 없습니다.
COOKIE_SAMESITE=lax
PORT=3000
HOST_PORT=3000
ASSIGNMENT_CONTAINER_PREFIX=assignment
# Aiven 같은 원격 MySQL은 검증된 TLS 연결을 사용합니다.
DB_SSL=false
# Aiven에서 받은 CA PEM 내용 (호스팅 환경 변수에 전체 내용 입력)
DB_SSL_CA=
# 영구 디스크가 없는 호스팅에서는 false. 기존 첨부파일은 별도 백업 필요.
ENABLE_ASSIGNMENT_IMAGE_UPLOADS=true
# 영구 볼륨이 있으면 이미지 저장 경로를 지정할 수 있습니다.
ASSIGNMENT_IMAGE_DIR=

# 이미지 전체 저장 한도(MB), 개별 이미지 최대 4MB
ASSIGNMENT_IMAGE_MAX_STORAGE_MB=512
